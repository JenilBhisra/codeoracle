# Server
HOST=127.0.0.1
PORT=8000

# CORS - comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173

# Groq API (required starting Backend Phase 6 - never commit real keys)
# Get a key at https://console.groq.com/keys
# GROQ_MODEL example: llama-3.3-70b-versatile - check the Groq console for
# the current full model list, since availability changes over time.
GROQ_API_KEY=
GROQ_MODEL=
# Comma-separated models tried in order if GROQ_MODEL's quota is exhausted.
# Different models have independent rate limits, so this keeps a demo
# working even if the primary model hits its cap. Optional.
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3
GROQ_RETRY_BASE_SECONDS=1
GROQ_RATE_LIMIT_BACKOFF_SECONDS=20
GROQ_MAX_CONCURRENCY=2

# Upload / processing limits
MAX_UPLOAD_MB=20
MAX_EXTRACTED_MB=50
MAX_FILES=1000
MAX_SOURCE_LINES=10000
MAX_FILE_BYTES=500000
JOB_TTL_MINUTES=60
