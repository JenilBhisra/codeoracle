# Server
HOST=127.0.0.1
PORT=8000

# CORS - comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173

# Gemini API (required starting Backend Phase 6 - never commit real keys)
# GEMINI_MODEL example: gemini-flash-latest (a rolling alias to Google's
# current recommended flash model - pinned dated versions like gemini-2.5-flash
# can become unavailable to new API keys; check Google AI Studio for options)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_MAX_CONCURRENCY=2

# Upload / processing limits
MAX_UPLOAD_MB=20
MAX_EXTRACTED_MB=50
MAX_FILES=1000
MAX_SOURCE_LINES=10000
MAX_FILE_BYTES=500000
JOB_TTL_MINUTES=60
